{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] },
    "dev": { "cache": false, "persistent": true }
  },
  "boundaries": {
    "tags": {
      "play": { "dependencies": { "allow": ["play", "shared"] } },
      "studio": { "dependencies": { "allow": ["studio", "shared"] } },
      "shared": { "dependencies": { "allow": ["shared"] } }
    }
  }
}
