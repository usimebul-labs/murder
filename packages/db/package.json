{
  "name": "@mm/db",
  "version": "0.0.0",
  "private": true,
  "description": "공용: Drizzle 스키마와 마이그레이션. 각 앱은 자기 테이블만 쓰고, 스튜디오↔게임 계약은 scenario_versions(불변)이다.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@mm/config": "workspace:*",
    "@types/node": "^22",
    "drizzle-kit": "^0.31.11",
    "typescript": "~5.9.3"
  }
}
