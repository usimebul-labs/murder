PORT=2567
# Supabase 대시보드 → Connect → Transaction pooler(6543) 연결 문자열. 비우면 DB 없이 샘플 시나리오만 사용
DATABASE_URL=
# Supabase Project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=
# Legacy HS256 JWT를 쓰는 프로젝트만 입력. 비대칭 키(기본)면 비워 두면 JWKS로 검증
SUPABASE_JWT_SECRET=
# 개발 전용: 로그인 없이 dev:닉네임 토큰 허용. 터널로 외부에 공개할 때는 반드시 비운다
DEV_AUTH=1
# LiveKit Cloud → Settings → Keys
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
REQUIRE_ENTITLEMENT=0
