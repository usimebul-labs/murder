{
  "name": "@mm/game",
  "version": "0.0.0",
  "private": true,
  "description": "게임 플레이: Colyseus 실시간 게임 서버",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.0",
    "@colyseus/schema": "^5.0.45",
    "@colyseus/ws-transport": "^0.18.4",
    "@mm/db": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "@mm/game-protocol": "workspace:*",
    "@mm/scenario-schema": "workspace:*",
    "jose": "^6.2.15",
    "livekit-server-sdk": "^2.19.2",
    "xstate": "^5.33.3"
  },
  "devDependencies": {
    "@mm/config": "workspace:*",
    "@types/node": "^22",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
